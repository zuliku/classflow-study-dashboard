# Kiro Search（联网搜索）可选 Tavily 增强凭据
# 不配置也能使用免 Key 的基础搜索（Exa / Parallel hosted MCP）。
# 配置后优先使用 Tavily（1,000 credits/月，中文结果更稳定）。
TAVILY_API_KEY=

# Legacy ClassFlow-specific alias（兼容；与 TAVILY_API_KEY 同时存在时优先使用本变量）
# KIRO_TAVILY_API_KEY=

# 运营/隐私安全阀：设为 1 时禁用所有免 Key hosted 搜索（企业策略/合规场景）
# CLASSFLOW_DISABLE_KEYLESS_WEB_SEARCH=1
