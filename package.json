{
  "name": "classflow-desktop",
  "version": "1.1.1",
  "description": "ClassFlow - 大学生课表与作业 DDL 学习管理系统（Windows 桌面版）",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "ClassFlow",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:terminal": "vitest run tests/terminalCapability.test.ts tests/terminalToolExposure.test.ts tests/terminalCapabilityPrompt.test.ts tests/terminalStreaming.test.ts tests/terminalSecretRedaction.test.ts tests/kiroTerminalBlock.test.tsx tests/terminalLifecycle.test.ts tests/terminalStdin.test.ts tests/terminalPtyContract.test.ts tests/terminalAsyncLifecycle.test.ts tests/terminalPtyAgentIntegration.test.ts tests/terminalFinalHardening.test.ts",
    "test:terminal:live": "vitest run tests/aiOpenCodeGoTerminalSmoke.test.ts tests/aiOpenCodeGoTerminalInteractiveSmoke.test.ts",
    "test:docx:fixtures": "vitest run scripts/docx-compat/generate-fixtures.test.ts",
    "test:docx:openxml": "node scripts/docx-compat/validate-openxml.mjs",
    "verify:preload-artifact": "node scripts/verify-preload-artifact.mjs",
    "pack:win": "electron-vite build && electron-builder --win nsis",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@ai-sdk/react": "^4.0.61",
    "@modelcontextprotocol/client": "^2.0.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.3",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "ai": "^7.0.58",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^9.7.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.427.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.12.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "electron": "43.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  }
}
